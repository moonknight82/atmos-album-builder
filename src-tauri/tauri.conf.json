{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atmos Album Builder",
  "version": "0.5.0",
  "identifier": "com.thiago.atmosalbumbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Atmos Album Builder",
      "width": 1440,
      "height": 900,
      "minWidth": 1040,
      "minHeight": 700
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**", "/media/**", "/mnt/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Build chaptered MKV albums while preserving Dolby Atmos audio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["third-party/FFmpeg-NOTICE.md", "third-party/FFmpeg-COPYING.LGPLv2.1.txt"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCREJBMzQyNEUyQ0IxQjkKUldTNXNTeE9RcVBiYXhVRHNFNzgwMnBSWHMvT0FyM0FQLzN3YkN2Z3c0d0Uram40dmVONFlnT08K",
      "endpoints": [
        "https://github.com/moonknight82/atmos-album-builder/releases/latest/download/latest.json"
      ]
    }
  }
}
